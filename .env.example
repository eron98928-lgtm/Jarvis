# JARVIS - Configurações de Ambiente (100% Gratuito)

# Google Gemini API Key (Obtenha em: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_aqui

# Configurações do Banco de Dados (SQLite)
DATABASE_URL=sqlite:///./data/db/jarvis.db

# Segurança
SECRET_KEY=uma_chave_secreta_muito_segura_para_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Configurações Administrativas
ADMIN_NAME=Eron
